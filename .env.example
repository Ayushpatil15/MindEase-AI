# MindEase AI — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Flask
FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-key

# Database
DATABASE_URL=sqlite:///mindease.db

# ML Model
MODEL_PATH=models/fer2013_cnn.h5

# AI Provider: "none" | "gemini" | "mistral"
AI_PROVIDER=none

# Only needed if AI_PROVIDER=gemini
GEMINI_API_KEY=

# Only needed if AI_PROVIDER=mistral
MISTRAL_API_KEY=
