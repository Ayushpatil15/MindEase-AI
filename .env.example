# MindEase AI — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# NEVER commit the .env file to version control.

# Application environment ('development', 'testing', 'production') — falls back to FLASK_ENV if set
APP_ENV=development

# Flask CLI application entrypoint script
FLASK_APP=run.py

# Cryptographic key for session cookies and CSRF tokens (strictly required in production)
SECRET_KEY=change-this-to-a-random-secret-key

# SQLAlchemy database connection URI (defaults to SQLite in instance/mindease.db)
DATABASE_URL=sqlite:///instance/mindease.db

# Dedicated TFLite production model file path
TFLITE_MODEL_PATH=models/deployment/challenger_fp32.tflite

# Number of CPU threads allocated to TFLite interpreter
TFLITE_NUM_THREADS=4

# Privacy threshold: minimum student cohort size required for aggregated admin analytics
MIN_AGGREGATION_GROUP_SIZE=5

# Optional: TensorFlow oneDNN CPU performance optimization flag (0=disabled, 1=enabled)
TF_ENABLE_ONEDNN_OPTS=1

# Google Gemini API key for student wellness chatbot (server-side only, keep secret)
GEMINI_API_KEY=your-gemini-api-key-here

# Google Gemini model identifier (low-cost prototype: gemini-2.5-flash-lite)
GEMINI_MODEL=gemini-2.5-flash-lite
